---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { brand, mainNav, legalNav } from '../../data/site';
import { allChannels } from '../../data/contact';

const productNav = mainNav.filter((n) => n.href !== '/');
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap">
    <div class="footer__top">
      <div class="footer__brand">
        <Logo size="large" />
        <p class="footer__tagline">{brand.taglineInline}</p>
        <p class="footer__support">{brand.support}</p>
        <ul class="footer__social" aria-label="Official channels">
          {
            allChannels.map((c) => (
              <li>
                <a
                  href={c.url}
                  target="_blank"
                  rel="noopener noreferrer external"
                  referrerpolicy="no-referrer"
                  aria-label={`${c.name}${c.handle ? ` ${c.handle}` : ''}`}
                  title={c.name}
                >
                  <Icon name={c.id} />
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <nav class="footer__col" aria-label="Products">
        <p class="footer__heading">SPEX</p>
        <ul>
          {productNav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
        </ul>
      </nav>

      <nav class="footer__col" aria-label="Information">
        <p class="footer__heading">Information</p>
        <ul>
          {legalNav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
        </ul>
      </nav>

      <div class="footer__col">
        <p class="footer__heading">Delivery</p>
        <ul>
          <li><a href="/shipping#meetups">Hamburg Meetups</a></li>
          <li><a href="/shipping#shipping">Worldwide Shipping</a></li>
          <li><a href="/shipping#payment">Payment information</a></li>
          <li><a href="/contact#official">Official contacts</a></li>
        </ul>
      </div>
    </div>

    <div class="footer__bottom">
      <p>SIMPLUGELITE / SPEX</p>
      <p>© {year} SIMPLUGELITE. All rights reserved.</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    padding-block: clamp(4rem, 8vw, 6rem) 2rem;
    background: linear-gradient(180deg, var(--black), var(--navy-900));
    border-top: 1px solid var(--line);
  }
  .footer__top {
    display: grid;
    gap: 3rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 720px) {
    .footer__top {
      grid-template-columns: 1.6fr 1fr 1fr 1fr;
    }
  }
  .footer__brand {
    display: grid;
    gap: 1rem;
    justify-items: start;
    align-content: start;
  }
  .footer__tagline {
    margin-top: 0.5rem;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--white);
  }
  .footer__support {
    color: var(--muted);
    font-size: 0.92rem;
    max-width: 22rem;
  }
  .footer__social {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin: 0.5rem 0 0;
    padding: 0;
  }
  .footer__social a {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    color: var(--muted);
    transition:
      color 0.25s var(--ease),
      border-color 0.25s var(--ease),
      background-color 0.25s var(--ease);
  }
  .footer__social a:hover {
    color: var(--white);
    border-color: var(--line-blue);
    background: rgba(47, 123, 255, 0.12);
  }
  .footer__social :global(svg) {
    width: 19px;
    height: 19px;
  }
  .footer__heading {
    margin-bottom: 1rem;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--muted-2);
  }
  .footer__col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }
  .footer__col a {
    color: var(--muted);
    font-size: 0.92rem;
    transition: color 0.2s var(--ease);
  }
  .footer__col a:hover {
    color: var(--white);
  }
  .footer__bottom {
    margin-top: 4rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem;
    font-size: 0.74rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted-2);
  }
</style>
