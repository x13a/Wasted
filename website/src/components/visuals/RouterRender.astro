---
import { uid } from '../../lib/uid';
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
const id = uid('rt');
---

<svg class={className} viewBox="0 0 380 250" role="img" aria-label="SPEX Router">
  <defs>
    <linearGradient id={`${id}-body`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#2a3142"></stop>
      <stop offset="0.5" stop-color="#121722"></stop>
      <stop offset="1" stop-color="#06080d"></stop>
    </linearGradient>
    <linearGradient id={`${id}-top`} x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#fff" stop-opacity="0.05"></stop>
      <stop offset="0.5" stop-color="#fff" stop-opacity="0.3"></stop>
      <stop offset="1" stop-color="#fff" stop-opacity="0.05"></stop>
    </linearGradient>
    <linearGradient id={`${id}-screen`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#0f2558"></stop>
      <stop offset="1" stop-color="#030812"></stop>
    </linearGradient>
    <radialGradient id={`${id}-led`}>
      <stop offset="0" stop-color="#9cc8ff"></stop>
      <stop offset="0.4" stop-color="#2f7bff"></stop>
      <stop offset="1" stop-color="#2f7bff" stop-opacity="0"></stop>
    </radialGradient>
  </defs>
  <rect x="10" y="30" width="360" height="200" rx="44" fill={`url(#${id}-body)`} stroke="#fff" stroke-opacity="0.08"></rect>
  <rect x="40" y="31" width="300" height="1.5" fill={`url(#${id}-top)`}></rect>
  <rect x="44" y="62" width="176" height="136" rx="18" fill={`url(#${id}-screen)`} stroke="#2f7bff" stroke-opacity="0.35"></rect>
  <g fill="#9cc0ff">
    <rect x="64" y="94" width="7" height="10" rx="1.5"></rect>
    <rect x="75" y="88" width="7" height="16" rx="1.5"></rect>
    <rect x="86" y="82" width="7" height="22" rx="1.5"></rect>
    <rect x="97" y="76" width="7" height="28" rx="1.5" fill-opacity="0.4"></rect>
  </g>
  <text x="196" y="104" text-anchor="end" font-size="16" font-weight="600" fill="#fff" letter-spacing="1">5G</text>
  <g fill="none" stroke="#9cc0ff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" transform="translate(64 128)">
    <path d="M12 2l10 4v7c0 6-4.3 10.6-10 11.6C6.3 23.6 2 19 2 13V6l10-4z"></path>
    <path d="M7.5 13l3 3 6-6.5"></path>
  </g>
  <text x="98" y="148" font-size="15" font-weight="600" fill="#fff" letter-spacing="2">VPN ON</text>
  <text x="64" y="180" font-size="11" fill="#fff" fill-opacity="0.5" letter-spacing="2">3 DEVICES</text>
  <circle cx="300" cy="96" r="22" fill={`url(#${id}-led)`} class="led"></circle>
  <circle cx="300" cy="96" r="5" fill="#cfe2ff"></circle>
  <text x="300" y="186" text-anchor="middle" font-size="14" font-weight="600" letter-spacing="6" fill="#fff" fill-opacity="0.55">SPEX</text>
  <rect x="268" y="138" width="64" height="4" rx="2" fill="#fff" fill-opacity="0.08"></rect>
</svg>

<style>
  .led {
    animation: pulse-glow 3.2s ease-in-out infinite;
  }
</style>
